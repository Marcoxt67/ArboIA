# ============================================================
# ARboIA — Configuração da chave de API (opcional)
# ============================================================
# Copie este arquivo para .env e preencha sua chave:
#     cp .env.example .env
#
# NUNCA commite o arquivo .env. Ele está no .gitignore.
# Sem chave, o sistema funciona offline (OCR + regras).
# ============================================================

# Chave da API (OpenAI sk-... ou Coarena coa_...)
OPENAI_API_KEY=sk-proj-COLOQUE_SUA_CHAVE_AQUI

# Base URL: deixe em branco para OpenAI padrão.
# Para Coarena, use https://coarena.ai/api/v1 (detectado automaticamente se a chave começar com coa_).
# OPENAI_BASE_URL=https://coarena.ai/api/v1

# Modelo multimodal
# - OpenAI: gpt-4o-mini ou gpt-4o
# - Coarena: gemini-3-8-flash, gemini-4-argon, gpt-6-2-astra, ...
OPENAI_MODEL=gpt-4o-mini

# Ativar/desativar tentativa de IA multimodal
# true  -> tenta multimodal primeiro, cai para OCR se falhar
# false -> usa apenas OCR local (offline)
USE_IA_MULTIMODAL=true

# Chave para manter o progresso da trilha de 10 fases na sessão
# Gere uma com: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria-de-64-caracteres

# Alternativa: usar outra variável de ambiente para a chave
# (se definida, tem prioridade sobre OPENAI_API_KEY em alguns fluxos)
# ARBOIA_API_KEY=
